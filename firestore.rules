rules_version = '2';

// Security rules for The Milton Paper's Firestore database.
//
// Deploy from the Firebase console (Firestore Database → Rules) or with:
//   firebase deploy --only firestore:rules
//
// Without these rules (e.g. while the database is in "test mode"), any client
// can read and write every document — including other users' profiles and
// TMPlay scores.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // "staff" is assigned by hand in the Firebase console and the users rules
    // below never let a client grant it to itself, so this lookup is a safe
    // authority check. It costs one read per write attempt and nothing on
    // reads, which are public.
    function isStaff() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('role', 'reader') == 'staff';
    }

    // User profiles and bookmarks. Each user can only touch their own
    // document, and can never grant themselves the "staff" role — staff is
    // assigned manually in the Firebase console.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.get('role', 'reader') == 'reader'
        && validProfile();

      allow update: if isOwner(uid)
        && request.resource.data.get('role', 'reader') == resource.data.get('role', 'reader')
        && validProfile();

      function validProfile() {
        return request.resource.data.get('displayName', '') is string
          && request.resource.data.get('displayName', '').size() <= 100
          && request.resource.data.get('bookmarkedArticleIDs', []) is list
          && request.resource.data.get('bookmarkedArticleIDs', []).size() <= 1000
          && request.resource.data.get('notificationTopics', []) is list
          && request.resource.data.get('notificationTopics', []).size() <= 20;
      }
    }

    // Daily TMPlay leaderboard. Document ID format: "<yyyy-MM-dd>_<uid>".
    match /wordleScores/{scoreId} {
      // Anyone can view the leaderboard (the app shows it to guests too).
      allow read: if true;

      // A signed-in user may only create/update their own score for today,
      // and only with sanely-shaped data.
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && scoreId == request.resource.data.date + '_' + request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 50
        && request.resource.data.tries is int
        && request.resource.data.tries >= 1
        && request.resource.data.tries <= 7
        && request.resource.data.seconds is int
        && request.resource.data.seconds >= 0
        && request.resource.data.seconds <= 86400;

      // Users may delete their own scores (used by account deletion).
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Front-page modules edited in the Firebase console (spotlights and
    // rails). Readers fetch these on the Today page before signing in, so
    // reads are public; only staff may change what the front page says.
    match /homeModules/{moduleId} {
      allow read: if true;

      allow create, update: if isStaff() && validModule();
      allow delete: if isStaff();

      function validModule() {
        return request.resource.data.type in ['spotlight', 'rail']
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 1
          && request.resource.data.title.size() <= 200
          && request.resource.data.enabled is bool
          && request.resource.data.order is number
          && request.resource.data.get('subtitle', '').size() <= 200
          && request.resource.data.get('body', '').size() <= 2000
          && request.resource.data.get('placement', 'afterIssue') in ['top', 'afterIssue'];
      }

      // The cards inside a rail module.
      match /items/{itemId} {
        allow read: if true;

        allow create, update: if isStaff()
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 1
          && request.resource.data.title.size() <= 200
          && request.resource.data.order is number
          && request.resource.data.get('subtitle', '').size() <= 200;
        allow delete: if isStaff();
      }
    }

    // One Connections puzzle per week, typed in the console. Public read, as
    // guests play too; only staff write. Semantic checks (four groups of four
    // distinct words) live in the app, which skips a bad document and keeps
    // last week's puzzle playable rather than showing an empty board.
    match /connectionsPuzzles/{puzzleId} {
      allow read: if true;

      allow create, update: if isStaff() && validPuzzle();
      allow delete: if isStaff();

      function validGroup(name, words) {
        return name is string
          && name.size() >= 1
          && name.size() <= 60
          && (words is string
                ? words.size() <= 300
                : (words is list && words.size() == 4));
      }

      function validPuzzle() {
        return request.resource.data.enabled is bool
          && request.resource.data.get('title', '') is string
          && request.resource.data.get('title', '').size() <= 80
          && request.resource.data.get('author', '') is string
          && request.resource.data.get('author', '').size() <= 80
          && validGroup(request.resource.data.group1Name, request.resource.data.group1Words)
          && validGroup(request.resource.data.group2Name, request.resource.data.group2Words)
          && validGroup(request.resource.data.group3Name, request.resource.data.group3Words)
          && validGroup(request.resource.data.group4Name, request.resource.data.group4Words);
      }
    }

    // Writer photos and bios for the masthead. Public read; only staff write.
    match /writers/{writerId} {
      allow read: if true;

      allow create, update: if isStaff()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.get('bio', '') is string
        && request.resource.data.get('bio', '').size() <= 1000
        && request.resource.data.get('role', '') is string
        && request.resource.data.get('role', '').size() <= 100;
      allow delete: if isStaff();
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
